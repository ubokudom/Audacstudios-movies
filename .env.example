# Copy these into Vercel → Project → Settings → Environment Variables
# (or into a file called .env.local when running on your own computer).

# Required
STUDIO_PASSWORD=choose-a-long-team-password
SESSION_SECRET=paste-any-long-random-text-here-at-least-32-characters
BYTEPLUS_API_KEY=your-modelark-api-key

# Optional
STUDIO_NAME=Cyberline Studio
# BytePlus region. Default is Singapore (ap-southeast-1):
# BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# What you pay per million video tokens, for the cost estimates (Light/Production plans = 6.4):
# VIDEO_PRICE_PER_M_TOKENS=6.4

# Set automatically when you connect a Vercel Blob store:
# BLOB_READ_WRITE_TOKEN=

# Only if BytePlus renames models: replace the model lists (JSON). See README.
# VIDEO_MODELS=
# IMAGE_MODELS=
